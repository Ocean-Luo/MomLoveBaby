@{
    ViewData["Title"] = "备孕知识";
}



<div class="container mt-4">
    
    <div class="card h-100 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">健康准备</h5>
        </div>
        <div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">孕前检查</h6>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">女性：妇科检查、TORCH筛查（弓形虫/风疹病毒等）、甲状腺功能、性激素六项</li>
                <li class="list-group-item">男性：精液常规、传染病筛查（乙肝/梅毒等）</li>
                <li class="list-group-item">建议：提前3-6个月检查，异常情况及时干预</li>
            </ul>
            
            <h6 class="card-subtitle mb-2 text-muted">营养补充</h6>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>叶酸</strong>：每日400μg，预防胎儿神经管畸形（孕前3个月开始）</li>
                <li class="list-group-item"><strong>铁/钙</strong>：缺铁女性需提前补充，钙每日800mg</li>
                <li class="list-group-item">饮食建议：多吃绿叶蔬菜、坚果、鱼类，避免高汞海鲜</li>
            </ul>
        </div>
    </div>
    
    <div class="card h-100 shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="card-title mb-0">生活习惯调整</h5>
        </div>
        <div class="card-body">
           
            <h6 class="card-subtitle mb-2 text-muted">禁忌事项</h6>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">戒烟戒酒（至少提前3个月）</li>
                <li class="list-group-item">避免高温环境（男性桑拿/紧身裤影响精子质量）</li>
                <li class="list-group-item">减少咖啡因（每日≤200mg，约1杯咖啡）</li>
            </ul>
            
            <h6 class="card-subtitle mb-2 text-muted">作息与运动</h6>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">保证7-8小时睡眠，调节内分泌</li>
                <li class="list-group-item">适度运动（如瑜伽、游泳），增强核心肌群</li>
            </ul>
        </div>
    </div>
    
    <div class="card h-100 shadow-sm">
         <div class="card-header bg-info text-white">
            <h5 class="card-title mb-0">心理与环境准备</h5>
        </div>
        <div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">压力管理</h6>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">通过冥想、社交活动缓解焦虑</li>
                <li class="list-group-item">夫妻共同参与备孕计划，减少单方压力</li>
            </ul>
            <h6 class="card-subtitle mb-2 text-muted">环境安全</h6>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">避免接触放射线、化学毒物（如装修污染）</li>
                <li class="list-group-item">宠物需做弓形虫检测，避免接触动物粪便</li>
            </ul>
        </div>
    </div>
</div>