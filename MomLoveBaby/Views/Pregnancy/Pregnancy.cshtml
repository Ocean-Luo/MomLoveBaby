@{
    ViewData["Title"] = "怀孕知识";
}

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-lg rounded-3" >
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">孕早期（0-12周）</h5>
                </div>
                 <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">妊娠反应管理</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">应对恶心呕吐：少量多餐，选择生姜、苏打饼干等缓解症状</li>
                        <li class="list-group-item">紧急情况：剧烈呕吐伴体重下降＞5%需就医（警惕妊娠剧吐）</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">营养重点</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">叶酸：每日补充400μg，持续至孕3个月</li>
                        <li class="list-group-item">饮食禁忌：禁烟酒、咖啡因每日≤200mg（约1杯咖啡）</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">风险防范</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">避免提重物、剧烈运动</li>
                        <li class="list-group-item">警惕腹痛/阴道出血（可能是宫外孕或先兆流产）</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 shadow-lg rounded-3" style="transition: all 0.3s ease; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">孕中期（13-28周）</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">核心检查项目</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">NT检查：11-13周+6天完成（筛查染色体异常）</li>
                        <li class="list-group-item">大排畸超声：20-24周（检测胎儿结构畸形）</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">营养调整</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">增加钙摄入（每日1000mg）：牛奶、豆腐、绿叶菜</li>
                        <li class="list-group-item">预防贫血：每周2次动物肝脏或红肉</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">生活方式</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">适宜运动：孕妇瑜伽、游泳（每周3-5次）</li>
                        <li class="list-group-item">开始胎教：每天播放轻柔音乐10-15分钟</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 shadow-lg rounded-3" style="transition: all 0.3s ease; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">孕晚期（29-40周）</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">产检频率</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">28-36周每2周1次，36周后每周1次</li>
                        <li class="list-group-item">必做项目：胎心监护（32周起）、B族链球菌筛查（36周）</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">身体变化应对</h6>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">缓解水肿：左侧卧位休息，限制盐分</li>
                        <li class="list-group-item">预防早产：识别规律宫缩/破水（立即就医）</li>
                    </ul>
                    
                    <h6 class="card-subtitle mb-2 text-muted">分娩准备</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">待产包清单（证件、产妇用品、婴儿衣物）</li>
                        <li class="list-group-item">学习拉玛泽呼吸法</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 shadow-lg rounded-3" style="transition: all 0.3s ease; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">全孕期通用建议</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">产检时间表</h6>
                    <table class="table table-bordered mb-3">
                        <thead>
                            <tr>
                                <th>孕周</th>
                                <th>关键检查</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>6-8周</td>
                                <td>建卡+超声确认孕周</td>
                            </tr>
                            <tr>
                                <td>24-28周</td>
                                <td>糖耐量试验</td>
                            </tr>
                        </tbody>
                    </table>
                    
                    <h6 class="card-subtitle mb-2 text-muted">危险信号清单</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">胎动异常（2小时＜10次）</li>
                        <li class="list-group-item">持续头痛/视物模糊（警惕子痫前期）</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>