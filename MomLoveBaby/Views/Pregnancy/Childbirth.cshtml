@{
    ViewData["Title"] = "分娩指南";
}

<div class="container mt-4">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"></div>
        <div class="col mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5>分娩前准备（37周起）</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-title">待产包清单</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>证件类</strong>：身份证、医保卡、产检本、银行卡</li>
                        <li class="list-group-item"><strong>妈妈用品</strong>：计量型卫生巾（3-5片）、产褥垫（10片）、吸管杯、一次性内裤</li>
                        <li class="list-group-item"><strong>宝宝用品</strong>：NB码纸尿裤（20片）、52码连体衣（2套）、婴儿润肤油</li>
                        <li class="list-group-item"><strong>特殊物品</strong>：胎心监护带（2条）、巧克力/能量饮料（补充体力）</li>
                    </ul>
                    <h6 class="card-title mt-3">身体信号识别</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>临产三大征兆</strong>：
                            <ul>
                                <li>规律宫缩（每5分钟1次，持续30秒以上）</li>
                                <li>见红（粉红色分泌物）</li>
                                <li>破水（无色无味液体，需立即平躺就医）</li>
                            </ul>
                        </li>
                        <li class="list-group-item"><strong>注意</strong>：初产妇出现规律宫缩即可住院，经产妇需提前入院</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5>分娩过程应对</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-title">三产程详解</h6>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>产程</th>
                                <th>持续时间</th>
                                <th>关键动作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>第一产程（开指）</td>
                                <td>6-12小时</td>
                                <td>深呼吸+变换体位（跪姿/侧卧）</td>
                            </tr>
                            <tr>
                                <td>第二产程（分娩）</td>
                                <td>0.5-2小时</td>
                                <td>配合医生指令「吸气-屏气-向下用力」</td>
                            </tr>
                            <tr>
                                <td>第三产程（胎盘）</td>
                                <td>5-30分钟</td>
                                <td>检查胎盘完整性</td>
                            </tr>
                        </tbody>
                    </table>
                    <h6 class="card-title mt-3">疼痛管理方案</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>无痛分娩</strong>：宫口开2-3指时申请，麻醉剂量仅为剖宫产1/10</li>
                        <li class="list-group-item"><strong>非药物镇痛</strong>：拉玛泽呼吸法（深吸4秒→慢呼6秒）、导乐球分散压力</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5>紧急情况处理</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-title">需立即就医的情形</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">破水后羊水浑浊（绿色/黄色）</li>
                        <li class="list-group-item">胎动骤减（2小时＜10次）</li>
                        <li class="list-group-item">持续剧烈腹痛伴出血</li>
                    </ul>
                    <h6 class="card-title mt-3">剖宫产指征</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">胎儿窘迫</li>
                        <li class="list-group-item">胎盘早剥</li>
                        <li class="list-group-item">头盆不称等</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>